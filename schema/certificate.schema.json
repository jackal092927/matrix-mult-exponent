{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Exact rational bilinear certificate v1",
  "$comment": "Runtime also enforces canonical reduced fractions, dimension-specific lengths, nonzero factors, all coefficients, duplicate-key rejection, and byte limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "domain",
    "dimensions",
    "declared_rank",
    "terms"
  ],
  "properties": {
    "format": {
      "const": "matrix-mult-bilinear-v1"
    },
    "domain": {
      "const": "Q"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m",
        "k",
        "n"
      ],
      "properties": {
        "m": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "declared_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "terms": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "a",
          "b",
          "c"
        ],
        "properties": {
          "a": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,8})(?:/[1-9][0-9]{0,8})?$"
            }
          },
          "b": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,8})(?:/[1-9][0-9]{0,8})?$"
            }
          },
          "c": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "string",
              "pattern": "^(?:0|-?[1-9][0-9]{0,8})(?:/[1-9][0-9]{0,8})?$"
            }
          }
        }
      }
    }
  }
}
