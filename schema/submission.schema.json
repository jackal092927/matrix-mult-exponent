{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Pinned matrix multiplication submission v1",
  "$comment": "Runtime also enforces safe paths without symlinks, hash and metadata equality, claim applicability, and certificate semantics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "certificate",
    "sha256",
    "domain",
    "dimensions",
    "declared_rank",
    "classification",
    "attribution",
    "claim"
  ],
  "properties": {
    "format": {
      "const": "matrix-mult-intake-v1"
    },
    "certificate": {
      "type": "string",
      "maxLength": 240,
      "pattern": "^certificates/(baselines|candidates)/[A-Za-z0-9][A-Za-z0-9_.-]*\\.json$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "domain": {
      "const": "Q"
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "m",
        "k",
        "n"
      ],
      "properties": {
        "m": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "k": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "n": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        }
      }
    },
    "declared_rank": {
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "classification": {
      "enum": [
        "known_baseline",
        "candidate"
      ]
    },
    "attribution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authors",
        "title",
        "year",
        "url"
      ],
      "properties": {
        "authors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          }
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "year": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9999
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https://"
        }
      }
    },
    "claim": {
      "enum": [
        "exact_identity",
        "square_recursion_bound"
      ]
    }
  }
}
